SERVER_HOST=localhost
SERVER_PORT=25565
SERVER_VERSION=1.21.11

# BOT_USERNAME:
# - For BOT_AUTH=offline: any string; the server sees this as the bot's username.
# - For BOT_AUTH=microsoft: your Microsoft account login email. The bot will
#   sign in as the Minecraft account attached to it, and its in-game name will
#   be that account's profile name (not this value).
BOT_USERNAME=SmartBot

# BOT_AUTH:
#   offline   — no auth; only works on servers with online-mode=false.
#   microsoft — full Microsoft / Xbox Live OAuth. First run prints a device-code
#               URL to stdout; visit it once and approve. Tokens cache in
#               $DATA_DIR/auth/ so subsequent runs are non-interactive.
BOT_AUTH=offline

# Optional command sent once after the bot's first spawn. Omit the leading slash.
# Example: JOIN_COMMAND=server Survival
# JOIN_COMMAND=

OWNER_USERNAME=YourMcName

# Reasoning provider. Codex is the default and reuses an existing ChatGPT login
# from `codex login`; no OPENAI_API_KEY is required. Keep `anthropic` available
# for machines that still use the existing Claude Agent SDK adapter. Set
# `openrouter` to use an OpenRouter API key instead.
AGENT_PROVIDER=codex

# OpenRouter only (omit these for Codex or Claude). API keys are accepted from
# AGENT_API_KEY or OPENROUTER_API_KEY and are never included in diagnostics.
# AGENT_PROVIDER=openrouter
# AGENT_API_KEY=sk-or-v1-...
# AGENT_MODEL=openai/gpt-4o-mini
# AGENT_BASE_URL=https://openrouter.ai/api/v1

# Optional absolute CLI overrides for non-standard installations.
# CODEX_EXECUTABLE=/opt/homebrew/bin/codex
# CLAUDE_CODE_EXECUTABLE=/opt/homebrew/bin/claude

DATA_DIR=./data
LOG_LEVEL=info
# Mirror every incoming Minecraft chat/system line to the terminal.
CHAT_MIRROR_ENABLED=true

HP_FLEE_THRESHOLD=6
FOOD_EAT_THRESHOLD=14
AGENT_IDLE_TICK_MINUTES=5

# Reconnect backoff after a network or server disconnect.
RECONNECT_BASE_DELAY_MS=1000
RECONNECT_MAX_DELAY_MS=60000
RECONNECT_JITTER_RATIO=0.2

# Legacy read-only dashboard compatibility. v0.1 is a headless release and the
# dashboard is deferred, so it is disabled by default. If you explicitly enable
# it, keep it on loopback unless you add an authenticated reverse proxy.
DASHBOARD_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
